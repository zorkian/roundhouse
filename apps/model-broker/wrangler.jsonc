{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roundhouse-v2-model-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  // AI_GATEWAY_TOKEN is stored as a Worker secret. It needs the account-level
  // AI Gateway Run permission for provider-native Unified Billing requests.
  "vars": {
    "AI_GATEWAY_ID": "roundhouse-v2-development",
    "ROUTING_MODEL": "openai/gpt-5.6-luna",
    "ROUTING_ROUTES": "{\"conversation\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-sol\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"high\"},\"qualify\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-luna\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"high\"},\"investigate\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-terra\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"high\"},\"plan\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-sol\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"max\"},\"implement\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-terra\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"max\"},\"review-holistic\":{\"provider\":\"anthropic\",\"model\":\"anthropic/claude-opus-5\",\"protocol\":\"anthropic-messages\",\"thinkingLevel\":\"max\"},\"review-security\":{\"provider\":\"moonshotai\",\"model\":\"moonshotai/kimi-k3\",\"protocol\":\"openai-completions\",\"thinkingLevel\":\"max\"},\"review-data\":{\"provider\":\"openai\",\"model\":\"openai/gpt-5.6-sol\",\"protocol\":\"openai-responses\",\"thinkingLevel\":\"max\"}}",
    "ROUTING_REASONING_EFFORT": "high",
  },
  "observability": { "enabled": true },
}
