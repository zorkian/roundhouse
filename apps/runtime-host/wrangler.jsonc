{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roundhouse-v2-runtime-host",
  "main": "../control-plane/src/runtime-host.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundhouse-v2-development",
      "database_id": "8d3dfa61-e922-4c7b-ae26-199319eba0b5",
    },
  ],
  "services": [
    {
      "binding": "MODEL_BROKER",
      "service": "roundhouse-v2-model-broker",
    },
  ],
  "containers": [
    {
      "class_name": "RoundhouseAttemptSandbox",
      "image": "../../Dockerfile.agent-runner",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 10240,
        "disk_mb": 20000,
      },
      "max_instances": 10,
      "rollout_active_grace_period": 3600,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTEMPT_SANDBOXES",
        "class_name": "RoundhouseAttemptSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "runtime-host-v1",
      "new_sqlite_classes": ["RoundhouseAttemptSandbox"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
