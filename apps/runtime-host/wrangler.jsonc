{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roundhouse-v2-runtime-host",
  "main": "../control-plane/src/runtime-host.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundhouse-v2-development",
      "database_id": "8d3dfa61-e922-4c7b-ae26-199319eba0b5",
    },
  ],
  "services": [
    {
      "binding": "MODEL_BROKER",
      "service": "roundhouse-v2-model-broker",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "roundhouse-v2-development-workspaces",
      "remote": true,
    },
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "roundhouse-v2-development-workspaces",
    "CLOUDFLARE_R2_ACCOUNT_ID": "07ff5b32b60ae3e5d613b90ddde90069",
  },
  "containers": [
    {
      "class_name": "RoundhouseRuntimeSandbox",
      "image": "../../Dockerfile.agent-runner",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 10240,
        "disk_mb": 20000,
      },
      "max_instances": 10,
      "rollout_active_grace_period": 3600,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTEMPT_SANDBOXES",
        "class_name": "RoundhouseRuntimeSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "runtime-host-v1",
      "new_sqlite_classes": ["RoundhouseAttemptSandbox"],
    },
    {
      "tag": "runtime-host-v2",
      "new_sqlite_classes": ["RoundhouseRuntimeSandbox"],
    },
    {
      "tag": "runtime-host-v3",
      "deleted_classes": ["RoundhouseAttemptSandbox"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "roundhouse-v2-runtime-host-production",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roundhouse-v2-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "services": [
        {
          "binding": "MODEL_BROKER",
          "service": "roundhouse-v2-model-broker-production",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "roundhouse-v2-production-workspaces",
          "remote": true,
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "CALLBACK_SIGNING_SECRET",
          "store_id": "ba2c9da053a64e33879014c5fa473a73",
          "secret_name": "roundhouse-v2-production-callback-signing-secret",
        },
      ],
      "vars": {
        "BACKUP_BUCKET_NAME": "roundhouse-v2-production-workspaces",
        "CLOUDFLARE_R2_ACCOUNT_ID": "00000000000000000000000000000000",
      },
      "containers": [
        {
          "class_name": "RoundhouseRuntimeSandbox",
          "image": "../../Dockerfile.agent-runner",
          "instance_type": {
            "vcpu": 1,
            "memory_mib": 10240,
            "disk_mb": 20000,
          },
          "max_instances": 10,
          "rollout_active_grace_period": 3600,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ATTEMPT_SANDBOXES",
            "class_name": "RoundhouseRuntimeSandbox",
          },
        ],
      },
      "migrations": [
        {
          "tag": "runtime-host-v1",
          "new_sqlite_classes": ["RoundhouseAttemptSandbox"],
        },
        {
          "tag": "runtime-host-v2",
          "new_sqlite_classes": ["RoundhouseRuntimeSandbox"],
        },
        {
          "tag": "runtime-host-v3",
          "deleted_classes": ["RoundhouseAttemptSandbox"],
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
