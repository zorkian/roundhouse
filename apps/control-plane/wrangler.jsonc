{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "roundhouse-v2-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  // Bundle the Cytoscape browser build as text so the Worker can serve it
  // from the same-origin /assets/workflow-graph.js route.
  "rules": [{ "type": "Text", "globs": ["**/cytoscape.min.js"] }],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "roundhouse-dev.rm-rf.rip",
      "custom_domain": true,
    },
  ],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundhouse-v2-development",
      "database_id": "8d3dfa61-e922-4c7b-ae26-199319eba0b5",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "RUN_WAKEUPS",
        "queue": "roundhouse-v2-development-wakeups",
      },
      {
        "binding": "CONVERSATION_TURNS",
        "queue": "roundhouse-v2-development-conversation-turns",
      },
    ],
    "consumers": [
      {
        "queue": "roundhouse-v2-development-wakeups",
        "dead_letter_queue": "roundhouse-v2-development-wakeups-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 15,
      },
      {
        "queue": "roundhouse-v2-development-conversation-turns",
        "dead_letter_queue": "roundhouse-v2-development-conversation-turns-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 15,
      },
    ],
  },
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "roundhouse-v2-development" },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "roundhouse-v2-development-workspaces",
      "remote": true,
    },
  ],
  "browser": { "binding": "BROWSER" },
  "services": [
    {
      "binding": "MODEL_BROKER",
      "service": "roundhouse-v2-model-broker",
    },
  ],
  "workflows": [
    {
      "name": "roundhouse-v2-development-attempt-execution",
      "binding": "ATTEMPT_EXECUTIONS",
      "class_name": "AttemptExecutionWorkflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATTEMPT_SANDBOXES",
        "class_name": "RoundhouseRuntimeSandbox",
        "script_name": "roundhouse-v2-runtime-host",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v2-phase-1",
      "new_sqlite_classes": ["RoundhouseAttemptContainer"],
    },
    {
      "tag": "resumable-visual-workspaces",
      "new_sqlite_classes": ["RoundhouseAttemptSandbox"],
      "deleted_classes": ["RoundhouseAttemptContainer"],
    },
    {
      "tag": "runtime-host-split",
      "deleted_classes": ["RoundhouseAttemptSandbox"],
    },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ARTIFACTS_NAMESPACE": "roundhouse-v2-development",
    "ARTIFACTS_REMOTE_ORIGIN": "https://07ff5b32b60ae3e5d613b90ddde90069.artifacts.cloudflare.net",
    "CONTROL_PLANE_ORIGIN": "https://roundhouse-v2-control-plane.default-07f.workers.dev",
    "PUBLIC_ORIGIN": "https://roundhouse-dev.rm-rf.rip",
    "GITHUB_APP_ID": "4281837",
    // User sign-in client ID of the development GitHub App; the matching
    // ROUNDHOUSE_GITHUB_CLIENT_SECRET is stored as a Worker secret.
    "GITHUB_CLIENT_ID": "Iv23liaPflwJhKpGfxvB",
    "GITHUB_START_COMMAND": "/roundhouse-dev start",
    "SANDBOX_TRANSPORT": "rpc",
    "BACKUP_BUCKET_NAME": "roundhouse-v2-development-workspaces",
    "CLOUDFLARE_R2_ACCOUNT_ID": "07ff5b32b60ae3e5d613b90ddde90069",
  },
  "observability": {
    "enabled": true,
  },
  // Production is rendered to wrangler.production.jsonc before use. The
  // syntactically valid sentinels below make an accidental direct deployment
  // fail resource lookup instead of targeting development resources.
  "env": {
    "production": {
      // Reuse the existing production Worker so its write-only GitHub App
      // private-key and webhook-secret bindings survive the V2 deployment.
      "name": "roundhouse-prod-control-plane",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "roundhouse.rm-rf.rip",
          "custom_domain": true,
        },
      ],
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roundhouse-v2-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "RUN_WAKEUPS",
            "queue": "roundhouse-v2-production-wakeups",
          },
          {
            "binding": "CONVERSATION_TURNS",
            "queue": "roundhouse-v2-production-conversation-turns",
          },
        ],
        "consumers": [
          {
            "queue": "roundhouse-v2-production-wakeups",
            "dead_letter_queue": "roundhouse-v2-production-wakeups-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 15,
          },
          {
            "queue": "roundhouse-v2-production-conversation-turns",
            "dead_letter_queue": "roundhouse-v2-production-conversation-turns-dlq",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "retry_delay": 15,
          },
        ],
      },
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "roundhouse-v2-production" },
      ],
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "roundhouse-v2-production-workspaces",
          "remote": true,
        },
      ],
      "browser": { "binding": "BROWSER" },
      "services": [
        {
          "binding": "MODEL_BROKER",
          "service": "roundhouse-v2-model-broker-production",
        },
      ],
      "workflows": [
        {
          "name": "roundhouse-v2-production-attempt-execution",
          "binding": "ATTEMPT_EXECUTIONS",
          "class_name": "AttemptExecutionWorkflow",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "ATTEMPT_SANDBOXES",
            "class_name": "RoundhouseRuntimeSandbox",
            "script_name": "roundhouse-v2-runtime-host-production",
          },
        ],
      },
      "migrations": [
        // This is the existing production Worker's terminal migration tag.
        // Keep it as the final entry so Wrangler applies no V2 control-plane
        // migrations when replacing the Worker in place. The V2 Durable
        // Object classes live on the separately named runtime-host Worker.
        {
          "tag": "execution-container-v1",
          "new_sqlite_classes": ["RoundhouseExecutionContainer"],
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "ARTIFACTS_NAMESPACE": "roundhouse-v2-production",
        "ARTIFACTS_REMOTE_ORIGIN": "https://00000000000000000000000000000000.artifacts.cloudflare.net",
        "CONTROL_PLANE_ORIGIN": "https://roundhouse-prod-control-plane.replace-me.workers.dev",
        "PUBLIC_ORIGIN": "https://roundhouse.rm-rf.rip",
        "GITHUB_APP_ID": "9999999",
        "GITHUB_CLIENT_ID": "Iv000000000000000000",
        "GITHUB_START_COMMAND": "/roundhouse start",
        "SANDBOX_TRANSPORT": "rpc",
        "BACKUP_BUCKET_NAME": "roundhouse-v2-production-workspaces",
        "CLOUDFLARE_R2_ACCOUNT_ID": "00000000000000000000000000000000",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
