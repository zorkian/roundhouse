{
  "name": "roundhouse",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "prettier --check . && node scripts/check-license-headers.mjs && tsc -b --pretty false && node --check containers/agent-runner/runner.mjs && vitest run && node scripts/check-production-config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-license-headers.mjs",
    "render:production-config": "node scripts/render-production-config.mjs",
    "runner:check": "node --check containers/agent-runner/runner.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/node": "^24.0.14",
    "jsonc-parser": "3.3.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.129.0",
    "yaml": "2.9.0"
  }
}
